# .shared_rc - Shared environment configuration
# This file is sourced by both .bashrc and .zshrc
# Use this for shell behavior, aliases, and functions only - NO PATH modifications

# ============================================================================
# Aliases
# ============================================================================

# Git
alias gs='git status'
alias gco='git checkout'
alias gb='git branch'
alias park='git checkout --detach next-master'

# Etc.
alias ll='ls -la'

# ============================================================================
# Tool Integrations (with lazy loading for performance)
# ============================================================================

# NVM: put the default node version on PATH eagerly so child processes
# (git hooks, editors, scripts) can find node/npm/npx. Sourcing nvm.sh is
# the slow part, so that stays lazy-loaded behind the nvm command.
# Assumes the default alias is a plain version number (e.g. "24.8.0").
if [[ -d "$HOME/.nvm" ]]; then
  export NVM_DIR="$HOME/.nvm"

  if [[ -s "$NVM_DIR/alias/default" ]]; then
    PATH="$NVM_DIR/versions/node/v$(<"$NVM_DIR/alias/default")/bin:$PATH"
  fi

  # Lazy load full nvm only for version switching
  nvm() {
    unset -f nvm
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
    nvm "$@"
  }
fi

# ============================================================================
# Status Checks
# ============================================================================

# Nag if yadm has uncommitted changes
[[ $(yadm diff --shortstat 2> /dev/null | tail -n1) != "" ]] && echo "\n\e[1;31myadm has uncommitted changes\e[0m" && yadm status --porcelain
